root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ Source and Headers
[*.{cpp,hpp,c,h,in}]
indent_style = space
indent_size = 4

# CMake Configuration
[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

# Shell Scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4

# Documentation & Data formats
[*.{md,markdown,json,yml,yaml}]
indent_style = space
indent_size = 2
